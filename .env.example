# Copy to .env and fill in. .env is git-ignored.

# --- PayPal (optional). Without these, Boxday runs a full offline mock of PayPal.
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# mock | sandbox (default: sandbox when the two values above are set, otherwise mock)
# PAYPAL_MODE=sandbox

# --- AI model. Default: local Ollama with qwen2.5:3b (free, runs on CPU or a small GPU).
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
# Any OpenAI-compatible server also works (LM Studio, llama.cpp server, vLLM...):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:1234
# LLM_MODEL=your-model
# LLM_API_KEY=
# No model at all: LLM_PROVIDER=heuristic (rule-based fallbacks, clearly labeled in the UI)

PORT=3040
